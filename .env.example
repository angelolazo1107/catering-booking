# Google Firebase Web App Configuration
# Obtain these from: Firebase Console -> Project Settings -> General -> Your Apps (Web </>)

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=cater-booking-xxxx.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=cater-booking-xxxx
VITE_FIREBASE_STORAGE_BUCKET=cater-booking-xxxx.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
